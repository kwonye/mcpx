{
  "name": "mcpx-desktop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "description": "mcpx desktop app",
  "homepage": "https://github.com/kwonye/mcpx",
  "author": "kwonye",
  "main": "./out/main/index.js",
  "build": {
    "appId": "io.github.kwonye.mcpx",
    "productName": "mcpx",
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icons/mcpx.icns",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "extendInfo": {
        "LSUIElement": true
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "resources/linux/",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "kwonye",
      "desktop": {
        "entry": {
          "Name": "mcpx",
          "Comment": "Local MCP gateway",
          "StartupWMClass": "mcpx"
        }
      }
    },
    "win": {
      "icon": "build/icons/mcpx.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "asar": true,
    "asarUnpack": [
      "resources/**"
    ],
    "files": [
      "out/**",
      "!out/**/*.map",
      "resources/**"
    ],
    "extraResources": [
      {
        "from": "../cli/dist",
        "to": "cli/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "kwonye",
        "repo": "mcpx"
      }
    ]
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:inspect": "electron-vite dev --remoteDebuggingPort 9222",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest",
    "e2e": "bunx playwright test",
    "desktop-install": "bash scripts/desktop-install.sh --flavor production",
    "desktop-install:devtools": "bash scripts/desktop-install.sh --flavor production --dev",
    "desktop-install:dev-app": "bash scripts/desktop-install.sh --flavor dev",
    "desktop-install:dev": "bash scripts/desktop-install.sh --flavor dev --dev",
    "desktop-install:dev:cdp": "bash scripts/desktop-install.sh --flavor dev --dev --remote-debugging-port 9222"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@sentry/electron": "^7.20.2",
    "electron-updater": "^6.8.11",
    "lucide-react": "0.468.0",
    "posthog-node": "^5.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xmldom/xmldom": "^0.8.15",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  },
  "trustedDependencies": [
    "electron",
    "electron-builder",
    "app-builder-bin",
    "dmg-license"
  ],
  "overrides": {
    "minimatch@^10.2.5": "^11.0.1",
    "minimatch@^9.0.3": "^11.0.1"
  }
}
